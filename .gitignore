# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env/
.venv/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Anaconda environment directories (do not commit local envs)
envs/

# Logs
*.log

# Django / SQLite databases
*.sqlite3

# Local environment config (if any)
.env.local
.env.*.local

# Simulation storage outputs (keep base templates, ignore auto_run worlds)
environment/frontend_server/storage/auto_run_*/

# Temp storage used by frontend
environment/frontend_server/temp_storage/

# Reverie runtime artifacts
**/reverie/backend_server/__pycache__/

# If you ever export checkpoints or large debug dumps, ignore them
checkpoints/
dumps/
