# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.env/
.venv/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Anaconda environment directories (do not commit local envs)
envs/

# Logs
*.log

# Django / SQLite databases
*.sqlite3

# Local environment config (if any)
.env.local
.env.*.local

# Simulation storage outputs (keep base templates, ignore auto_run worlds)
environment/frontend_server/storage/auto_run_*/

# Temp storage used by frontend
environment/frontend_server/temp_storage/

# Reverie runtime artifacts
**/reverie/backend_server/__pycache__/

# If you ever export checkpoints or large debug dumps, ignore them
checkpoints/
dumps/

# Test outputs
all_chats.json
verify_changes.py
check_8am.py
check_schedule_overlap.py

# Ignore all simulation storage outputs except the clean base template
environment/frontend_server/storage/*
!environment/frontend_server/storage/base_the_ville_clean/
!environment/frontend_server/storage/base_the_ville_clean/**

# Ignore the entire generative_agents-main directory (backend code)
generative_agents-main/
